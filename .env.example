# ---------------------------------------------------------------------------
# ABDCM — variáveis de ambiente
# Nenhum valor real de credencial entra neste arquivo nem em qualquer outro
# arquivo do repositório (invariante I10). Copie para .env.local e preencha.
# ---------------------------------------------------------------------------

# Segredo usado para assinar o cookie de sessão (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Banco de dados — obrigatório. Postgres local (Docker ou instalação nativa),
# Supabase ou Vercel Postgres (Neon) servem igual, é conexão Postgres padrão.
# Depois de definir, rode: npm run db:migrate && npm run db:seed
DATABASE_URL=postgresql://user:senha@localhost:5432/abdcm

# Supabase (banco, Auth, Storage) — ainda não utilizado na demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integrações — todas atrás de adaptador. "mock" roda sem conta externa.
PIX_PROVIDER=mock
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=mock
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

ASSINATURA_PROVIDER=mock
ZAPSIGN_API_TOKEN=
ZAPSIGN_WEBHOOK_SECRET=
