# Banco de dados — obrigatório agora que a persistência é real (Postgres).
# Local (Docker/instalação nativa), Railway, Supabase ou Vercel Postgres
# servem igual, é conexão Postgres padrão. Depois de definir, rode:
#   npm run db:migrate && npm run db:seed
DATABASE_URL=""

# Node Environment
NODE_ENV="development"
PORT=3000

# Login real (parceiro e administrador) — assina o cookie de sessão.
# Obrigatório em produção: sem isso, o servidor gera um segredo aleatório a
# cada restart e todo mundo é deslogado. Gere com: openssl rand -hex 32
SESSION_SECRET=""

# Só usadas por `npm run db:seed`, pra criar as duas contas de demonstração
# (parceiro e administrador) com login real já funcionando. Deixe em branco
# pra pular — dá pra criar contas depois com `npm run db:criar-conta`.
SEED_PARCEIRO_SENHA=""
SEED_ADMIN_SENHA=""

# GEMINI_API_KEY: nenhum código usa isto ainda (nenhum recurso de IA foi
# implementado). Pode deixar em branco.
GEMINI_API_KEY=""

# Provedores de Integração (Modo: 'mock' ou 'real'). Com "mock" o sistema
# funciona inteiro sem nenhuma conta externa — QR PIX simulado, avisos de
# WhatsApp só registrados no log do servidor.
PIX_PROVIDER="mock"
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_SECRET=""

# WhatsApp via Z-API (não-oficial, sem homologação Meta). Client-Token é o
# token de segurança da CONTA Z-API, diferente do token da instância.
WHATSAPP_PROVIDER="mock"
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# Storage (CNH/RG, fichas assinadas) via Cloudflare R2 — sem chave, o
# upload cai no modo mock (guarda em disco local, só pra testar o fluxo
# com poucos arquivos). Em produção o navegador manda o arquivo direto pro
# R2 com uma URL assinada; o servidor nunca recebe o arquivo em si.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

ASSINATURA_PROVIDER="mock"
ZAPSIGN_API_TOKEN=""
CLICKSIGN_API_TOKEN=""

# Leitura automática de CNH/RG no anexo em massa de documentos (extrai nome
# e CPF direto da imagem via Claude). Com "mock", todo arquivo cai na fila de
# conferência manual — nada é lido de verdade, mas o fluxo funciona igual.
# Exige STORAGE real (R2) também: a URL do documento precisa ser alcançável
# pela Anthropic, e a do storage mock é só local.
OCR_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# Monitoramento processual automático via JUDIT (judit.io) — acompanha o
# andamento do processo judicial de cada lote e avisa por webhook quando
# há movimentação nova (aba Processos do admin). Com "mock", o lote fica
# marcado como "monitorado" mas nenhuma movimentação chega sozinha — ainda
# dá pra usar o sistema normalmente, só sem esse acompanhamento automático.
MONITORAMENTO_PROVIDER="mock"
JUDIT_API_KEY=""
JUDIT_WEBHOOK_TOKEN=""
# URL pública (com HTTPS) onde este servidor está acessível de fora — a
# JUDIT precisa alcançar essa URL pra entregar o webhook. Só é exigida com
# MONITORAMENTO_PROVIDER=real; em mock não é usada. Ex.: https://app.abdcm.org.br
APP_PUBLIC_URL=""

# Consulta de baixa via Serasa — pra cada registro protocolado, pergunta
# periodicamente se a restrição ainda está ativa; se não estiver mais, dá
# baixa automaticamente (mesmo caminho da baixa manual, com ProcessEvent).
# Com "mock", nunca dá baixa sozinho — só o jeito manual de sempre continua
# funcionando. Alternativa a configurar aqui: colar a chave direto na tela
# Admin > Configurações > APIs (fica no banco, criptografada — ver
# CREDENCIAIS_ENCRYPTION_KEY abaixo).
BUREAU_PROVIDER="mock"
SERASA_CLIENT_ID=""
SERASA_CLIENT_SECRET=""

# Chave mestra (AES-256, 32 bytes em base64) pra criptografar as chaves de
# API que o admin colar na tela Configurações > APIs — elas ficam salvas no
# banco, nunca em texto puro (I10 revisado, ver CLAUDE.md seção 2). SEM esta
# variável, a tela de colar chave não funciona (continua dando pra usar
# variável de ambiente normalmente pra qualquer integração, como sempre).
# Gere com: openssl rand -base64 32
CREDENCIAIS_ENCRYPTION_KEY=""
