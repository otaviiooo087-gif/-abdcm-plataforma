# Banco de dados — obrigatório agora que a persistência é real (Postgres).
# Local (Docker/instalação nativa), Railway, Supabase ou Vercel Postgres
# servem igual, é conexão Postgres padrão. Depois de definir, rode:
#   npm run db:migrate && npm run db:seed
DATABASE_URL=""

# Node Environment
NODE_ENV="development"
PORT=3000

# GEMINI_API_KEY: nenhum código usa isto ainda (nenhum recurso de IA foi
# implementado). Pode deixar em branco.
GEMINI_API_KEY=""

# Provedores de Integração (Modo: 'mock' ou 'real') — ainda não usados no
# código atual, mantidos aqui como documentação do que vem a seguir.
PIX_PROVIDER="mock"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_SECRET=""

WHATSAPP_PROVIDER="mock"
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

ASSINATURA_PROVIDER="mock"
ZAPSIGN_API_TOKEN=""
CLICKSIGN_API_TOKEN=""
